# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env.

# ---------- Server ----------
PORT=5001
# IP to bind to. Leave empty for all interfaces (0.0.0.0). Docker compose forces 0.0.0.0.
IP_ADDRESS=
NODE_ENV=development

# ---------- Database ----------
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority

# ---------- Auth ----------
SALT_ROUNDS=10
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=30d
JWT_REFRESH_EXPIRATION=30d

# ---------- Admin ----------
# Email that receives admin notifications (e.g. support form submissions)
ADMIN_EMAIL=admin@example.com
# Password for the seeded admin account (admin@gmail.com). Min 12 chars; seeding is skipped if empty.
ADMIN_PASSWORD=

# ---------- Email service ----------
# External HTTP endpoint that sends emails
SEND_EMAIL_URL=https://<email-service-host>/send-email

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_xxx
# Required: webhooks reject unsigned events. Stripe Dashboard > Developers > Webhooks (or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_RETURN_URL=https://<frontend-host>/stripe-connect/return
STRIPE_CONNECT_REFRESH_URL=https://<frontend-host>/stripe-connect/refresh
PAYMENT_SUCCESS_URL=https://<frontend-host>/payment/success
PAYMENT_SUCCESS_URL_WEB=https://<frontend-host>/payment/success
PAYMENT_CANCEL_URL=https://<frontend-host>/payment/cancel
SUBSCRIPTION_SUCCESS_URL=https://<frontend-host>/subscription/success
SUBSCRIPTION_CANCEL_URL=https://<frontend-host>/subscription/cancel

# ---------- AWS S3 (file uploads) ----------
S3_BUCKET_ACCESS_KEY=
S3_BUCKET_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=
# Public base URL for uploaded files, ending with /
S3_BASE_URL=https://<bucket>.s3.<region>.amazonaws.com/
# Optional: custom S3-compatible endpoint (e.g. DigitalOcean Spaces); currently unused
S3_API=
SPACES_API=

# ---------- Google Maps ----------
GOOGLE_MAPS_API_KEY=

# ---------- Business rules ----------
PLATFORM_ORDER_COMMISSION_PERCENT=5
RIDER_DELIVERY_COMMISSION_PERCENT=5
CUSTOMER_SERVICE_FEE=1
SERVICE_FEE_REWARD_TIER_PERCENT=10
